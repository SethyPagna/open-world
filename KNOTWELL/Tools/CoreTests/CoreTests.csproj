<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Game.Core without Unity: proves Core has no engine dependency and runs its pure tests in seconds.
      dotnet test Tools/CoreTests
    Compiles Code/Core/** plus Tests/EditMode/Core/** (those tests must not use UnityEngine).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProjectRoot>$(MSBuildThisFileDirectory)..\..\</ProjectRoot>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)Assets\_Knotwell\Code\Core\**\*.cs" />
    <Compile Include="$(ProjectRoot)Assets\_Knotwell\Tests\EditMode\Core\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ProjectRoot)Library\PackageCache\com.unity.nuget.newtonsoft-json@4dfd81071c64\Runtime\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
</Project>
